# ============================================
# 1对1教学工作台 - 生产环境变量
# 使用方法: cp .env.production.example .env
# ============================================

# Docker Compose 变量
FRONTEND_PORT=80
TAG=latest

# ====== 安全配置 ======

# JWT 密钥（请生成强随机字符串）
# 生成方式: openssl rand -hex 32
JWT_SECRET=

# 允许跨域的前端地址（多个用逗号分隔）
CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# ====== SenseNova AI 配置 ======

# SenseNova API Key（在 https://platform.sensenova.cn 控制台创建）
SENSENOVA_API_KEY=

# 接口地址（一般无需修改）
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 模型选择
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# ====== 管理员账号（首次启动自动创建）======
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=your-strong-password-here
