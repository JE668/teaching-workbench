# ============================================
# 1对1教学工作台 - 生产环境变量
# 使用方法: cp .env.production.example .env
# ============================================

# ====== 端口 ======
# 前端对外端口（宿主机端口）。容器内 nginx 固定监听 80，这里只改宿主机映射。
# 不想占用 80 就改，例如 10880。改完记得同步 Lucky 的反代上游地址。
FRONTEND_PORT=80
# 镜像标签（回滚时可指定具体版本，如 sha 或 v1.2.3）
TAG=latest

# ====== 安全配置 ======

# JWT 密钥：用于签发登录令牌，一旦泄露，任何人都能伪造登录。
# 留空也可以 —— 后端首次启动会自动生成强随机密钥并持久化到 data/.jwt_secret。
# 若希望自行管理（便于备份/迁移），用下面命令生成后填入：
#   openssl rand -hex 32
JWT_SECRET=

# 允许跨域的前端地址（多个用逗号分隔）
# 标准部署下前端 nginx 会把 /api 反代到后端，浏览器看到的是同源请求，
# 因此**此项可以留空**。仅当"前后端分域部署"（前端直接调用另一个域名的后端）时才需填写。
CORS_ORIGINS=

# ====== SenseNova AI 配置 ======

# SenseNova API Key（在 https://platform.sensenova.cn 控制台创建）
SENSENOVA_API_KEY=

# 接口地址（一般无需修改）
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 模型选择
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# 思考强度：none / low / medium / high / max
# 影响生成质量与响应速度的权衡：
#   none   最快最省，但对"三段结构+字数区间"的遵循度偏弱，易触发重试
#   low    推荐默认，速度与遵循度较平衡
#   medium/high  更稳，但更慢、更耗 token
SENSENOVA_REASONING_EFFORT=low

# 单次请求超时（毫秒）。默认 60000（60 秒）。
# 模型响应慢时可调大，但建议不超过 120000，否则用户等待体验很差。
SENSENOVA_TIMEOUT_MS=60000

# ====== 管理员账号（首次启动自动创建）======
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=your-strong-password-here
