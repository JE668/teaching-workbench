{
  "name": "teaching-workbench-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:prepare": "node -e \"require('fs').rmSync('../server/.e2e-data',{recursive:true,force:true})\" && npm run typecheck:e2e && npm run build --prefix ../server && vite build",
    "e2e": "npm run e2e:kill && playwright test",
    "e2e:full": "npm run e2e:kill && npm run e2e:prepare && playwright test",
    "e2e:kill": "lsof -tiTCP:3111,3999,4173 -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null || true"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "exceljs": "^4.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^6.1.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch": "^11.0.1",
    "glob": "^14.0.3"
  }
}